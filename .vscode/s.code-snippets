	"Novo padrão BackEnd": {
		"prefix": "novo_arquivo_backEnd",
		"body": [
			"$LINE_COMMENT Arquivo criado: ${CURRENT_DATE}/${CURRENT_MONTH}/${CURRENT_YEAR} às ${CURRENT_HOUR}:${CURRENT_MINUTE}",
			"",
			"import NextAuth from '@/api/auth/[...nextauth].js'",
			"import admin from '@/lib/backEnd/firebase.js'",
			"import { unstable_getServerSession } from 'next-auth/next'",
			"",
			"export default async function handler(req, res) {",
			"  if (req.method === 'POST') {",
			"",
			"    const { email } = req.body",
			"",
			"    if (email) {",
			"",
			"      const logado = await unstable_getServerSession(req, res, NextAuth)",
			"",
			"      if (logado) {",
			"        const user = admin.firestore().collection('usuarios').doc(email)",
			"",
			"        const personagens = await user.collection('personagems').get()",
			"        const data = personagens.docs.map(doc => {",
			"          return {",
			"            id: doc.id,",
			"            descricao: doc.data().descricao,",
			"            nome: doc.data().nome,",
			"            img: doc.data().img",
			"          }",
			"        })",
			"        return res.status(200).json(data)",
			"      } else {",
			"        return res.status(401).json({ error: 'Unauthorized' })",
			"      }",
			"    } else {",
			"      return res.status(400).json({ error: 'Bad Request' })",
			"    }",
			"",
			"  }",
			"}",
			""
		],
		"description": "Crie um arquivo base para iniciar o backEnd"
	},
	"Requisição ao backEnd": {
		"prefix": "backEnd_useEffect",
		"body": [
			"const [isLoading, setLoading] = useState(true)",
			"  const state = useSelector(state => state.user)",
			"",
			"  useEffect(() => {",
			"",
			"    const getInfos = async () => {",
			"      BackEnd('allFichas', {",
			"        email: state.email",
			"      }).then(data => {",
			"        setFichas(data)",
			"        setLoading(false)",
			"      }).catch(() => {",
			"        Swal.fire({",
			"          title: 'Erro',",
			"          text: 'Não foi possível carregar as informações. Tente novamente mais tarde!',",
			"          icon: 'error',",
			"          confirmButtonText: 'Ok'",
			"        }).then(() => {",
			"          setLoading(false)",
			"        })",
			"      })",
			"    }",
			"",
			"    if (state.email && state.token) getInfos()",
			"  }, [state.email, state.token])"
		],
		"description": "use effect pronto para iniciar uma requisição ao backEnd"
	}
}